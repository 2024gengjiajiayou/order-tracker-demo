.hero {
  background: linear-gradient(135deg, #2b6cb0 0%, #4299e1 100%);
  color: #fff;
  padding: 44rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 176, 0.25);
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.3;
}
.hero-sub {
  font-size: 26rpx;
  opacity: 0.92;
  margin-top: 10rpx;
  line-height: 1.5;
}

/* 广告位 */
.banner-card { padding: 0; overflow: hidden; }
.banner-swiper { height: 260rpx; border-radius: 24rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; display: block; }

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
  line-height: 1.6;
  color: #4a5568;
  font-size: 27rpx;
}
.step:last-child { margin-bottom: 0; }
.num {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #2b6cb0;
  color: #fff;
  font-size: 24rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.openid {
  display: block;
  word-break: break-all;
  background: #f3f6fb;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #4a5568;
  margin-bottom: 16rpx;
  line-height: 1.6;
}
.tip {
  font-size: 24rpx;
  color: #a0aec0;
  line-height: 1.7;
}
.link-btn {
  margin-top: 20rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
  color: #2b6cb0;
  background: #eef4fb;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
