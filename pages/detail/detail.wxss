.kv {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
  font-size: 28rpx;
  line-height: 1.6;
}
.kv:last-child { border-bottom: none; }
.k {
  width: 180rpx;
  flex: none;
  color: #8a94a6;
  font-size: 27rpx;
}
.v {
  flex: 1;
  color: #1f2937;
  word-break: break-all;
}
.amount {
  color: #e53e3e;
  font-weight: 700;
  font-size: 32rpx;
}
.proj {
  color: #2b6cb0;
}
.col {
  display: flex;
  flex-direction: column;
}
.track-no {
  display: inline-flex;
  align-items: center;
  color: #2b6cb0;
  background: #f3f6fb;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  margin: 0 12rpx 10rpx 0;
  align-self: flex-start;
  line-height: 1;
  font-size: 26rpx;
}
.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img {
  width: 200rpx;
  height: 200rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 14rpx;
  display: block;
}
.edit-btn {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(49, 130, 206, 0.3);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
