page {
  background: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a202c;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f0f2f5;
  display: flex;
  align-items: center;
}
.card-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #2b6cb0;
  margin-right: 14rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #2d3748;
  margin-bottom: 14rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-height: 40rpx;
}

.req {
  color: #e53e3e;
  margin-left: 6rpx;
}

.muted {
  color: #a0aec0;
  font-weight: 400;
  font-size: 22rpx;
  margin-left: 10rpx;
}

.input, .picker {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a202c;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: #3182ce;
}

/* picker 用 flex 居中，避免 line-height 在不同机型上导致文字偏移 */
.picker {
  position: relative;
  color: #1a202c;
  display: flex;
  align-items: center;
  line-height: 1.4;
}

.picker-arrow::after {
  content: '';
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #a0aec0;
  border-bottom: 3rpx solid #a0aec0;
  transform: translateY(-70%) rotate(45deg);
}

.empty-tip {
  background: #fffaf0;
  border: 1rpx solid #fbd38d;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #c05621;
  line-height: 1.6;
}

/* 快递单号区域 */
.track-card {
  background: #f7fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 20rpx;
}

.track-list {
  margin-bottom: 4rpx;
}

.track-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.track-input {
  flex: 1;
  background: #fff;
}

.track-del {
  width: 60rpx;
  height: 60rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #fde8e8;
  color: #e53e3e;
  font-size: 34rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.track-add {
  display: inline-flex;
  align-items: center;
  color: #3182ce;
  font-size: 26rpx;
  padding: 12rpx 0 4rpx;
  font-weight: 500;
}

/* 金额输入 */
.input-amount {
  font-weight: 600;
  color: #1a202c;
}

/* 备注 */
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #1a202c;
  line-height: 1.6;
  height: 240rpx;
}

/* 图片上传 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}

.img-item, .img-add {
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  position: relative;
}

.img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  display: block;
}

.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.img-add {
  border: 2rpx dashed #cbd5e0;
  color: #a0aec0;
  font-size: 60rpx;
  background: #f7fafc;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(49, 130, 206, 0.3);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.submit-btn[disabled] {
  background: #a0aec0;
  box-shadow: none;
}

/* 团队相关 */
.tip {
  font-size: 25rpx;
  color: #8a94a6;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.team-line {
  display: inline-block;
  font-size: 23rpx;
  color: #2b6cb0;
  background: #eef4fb;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  margin: -8rpx 0 20rpx;
  line-height: 1;
}

.join-code {
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
