@import "/pages/submit/submit.wxss";

.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a202c;
  display: flex;
  align-items: center;
  line-height: 1.4;
}
.status-tip {
  font-size: 24rpx;
  color: #c05621;
  margin-top: 14rpx;
  line-height: 1.6;
}

/* “加载中…”用的是 card + empty，不需要空状态圆圈 */
.card.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #a0aec0;
  font-size: 28rpx;
}
.card.empty::before {
  display: none;
}
